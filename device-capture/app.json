{
  "expo": {
    "name": "CableMint Device Capture",
    "slug": "cablemint-device-capture",
    "version": "1.4.1",
    "orientation": "portrait",
    "icon": "./assets/CableMintToolsLogo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 23,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "package": "com.cableminttools.devicecapture.prototype",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/CableMintToolsLogo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CableMint Device Capture to read equipment labels",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose equipment-label or Gap evidence photos",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "./plugins/withSmartBarcode.cjs"
    ]
  }
}
